# Copy to bench/.env (git-ignored) and fill in. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=
SIEVE_MCP_URL=
BASELINE_URL=http://127.0.0.1:8765/mcp
# Optional: where the baseline server writes its call log (default bench/results/.baseline-server-log.jsonl).
BENCH_SERVER_LOG=
# Sieve arm only: the Firebase project id the bench stack runs under, and the Firestore emulator.
SIEVE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
