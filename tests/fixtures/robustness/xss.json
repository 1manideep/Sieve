{
  "note": "R-UI-01: each payload sets window.__xss if it ever runs",
  "cases": [
    {
      "id": "script",
      "input": "<script>window.__xss=1</script>",
      "expected": {
        "renderedAsText": true,
        "xss": "undefined",
        "network": []
      }
    },
    {
