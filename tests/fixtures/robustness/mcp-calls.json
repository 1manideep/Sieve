    {
      "id": "rlo-question",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"where is my \u202Etisoped\u202C\"}}}"
      },
      "expected": {
        "status": 200,
        "accepted": true,
        "shownQuestion": "where is my tisoped"
      },
      "note": "R-MCP-04: Cf characters reach the doc; the home base cleans them"
    },
    {
      "id": "invisible-only-question",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"\u200B\u200B\u2060\"}}}"
      },
      "expected": {
        "status": 200,
        "accepted": true,
        "finalMessage": "The question had no readable words. Ask again in plain text."
      },
      "note": "R-MCP-04: empty after cleaning ends with error"
    },
    {
      "id": "check-foreign-id",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_check\",\"arguments\":{\"request_id\":\"AAAAAAAAAAAAAAAAAAAA\"}}}"
      },
      "expected": {
        "status": 200,
        "message": "Sieve has no request with that id for this connection. It may have expired; ask again.",
        "requestId": null
      },
      "note": "R-MCP-07"
    },
    {
      "id": "dedupe-repeat",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"What did my landlord say about the deposit?\"}}}",
        "repeatAfterSeconds": 5
      },
      "expected": {
        "requestDocs": 1,
        "sameRequestId": true
      },
      "note": "R-MCP-06"
    }
