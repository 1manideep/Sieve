{
  "cases": [
    {
      "id": "not-json",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\": \"2.0\", "
      },
      "expected": {
        "status": 400,
        "rpcError": -32700,
        "message": "Parse error"
      }
    },
    {
      "id": "array-batch",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}]"
      },
      "expected": {
        "status": 400,
        "rpcError": -32600,
        "message": "Batching is not supported"
      }
    },
    {
      "id": "get",
      "input": {
        "method": "GET",
        "headers": {},
        "body": ""
      },
      "expected": {
        "status": 405,
        "headers": {
          "Allow": "POST"
        }
      }
    },
    {
      "id": "body-17kb",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"\"}}}"
      },
      "expected": {
        "status": 413
      }
    },
    {
      "id": "wrong-content-type",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}"
      },
      "expected": {
        "status": 415
      }
    },
    {
      "id": "id-null",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"tools/list\"}"
      },
      "expected": {
        "status": 400,
        "rpcError": -32600,
        "message": "Invalid Request"
      }
    },
    {
      "id": "unknown-link",
      "input": {
        "method": "POST",
        "path": "/mcp/not-a-real-link",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}"
      },
      "expected": {
        "status": 404,
        "body": {
          "error": "unknown_connector"
        }
      }
    },
    {
      "id": "args-after-null",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"my deposit\",\"after\":null}}}"
      },
      "expected": {
        "status": 200,
        "accepted": true,
        "hints": null
      }
    },
    {
      "id": "args-terms-string",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"order status\",\"terms\":\"A1\"}}}"
      },
      "expected": {
        "status": 200,
        "toolError": "terms must be a list of at most 5 exact identifiers, each 1 to 64 characters."
      }
    },
    {
      "id": "args-limit",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"my deposit\",\"limit\":5}}}"
      },
      "expected": {
        "status": 200,
        "toolError": "Unknown argument \"limit\". Allowed: question, after, before, source, from, terms."
      }
    },
    {
      "id": "args-question-number",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":42}}}"
      },
      "expected": {
        "status": 200,
        "toolError": "The question must be 1 to 500 characters of plain text."
      }
    },
    {
      "id": "args-bad-date",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"my deposit\",\"after\":\"2026-02-30\"}}}"
      },
      "expected": {
        "status": 200,
        "toolError": "after must be a real date written as YYYY-MM-DD, for example 2026-10-01."
      }
    },
    {
      "id": "args-day-first-date",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"my deposit\",\"before\":\"16/11/2026\"}}}"
      },
      "expected": {
        "status": 200,
        "toolError": "before must be a real date written as YYYY-MM-DD, for example 2026-10-01."
      }
    },
    {
      "id": "args-after-before",
      "input": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sieve_answer\",\"arguments\":{\"question\":\"my deposit\",\"after\":\"2026-10-05\",\"before\":\"2026-10-01\"}}}"
      },
      "expected": {
        "status": 200,
        "toolError": "after must be on or before before."
      }
    },
