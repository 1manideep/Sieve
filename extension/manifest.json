{
  "manifest_version": 3,
  "name": "Sieve",
  "version": "0.1.1",
  "description": "Approve what your AI assistant may see. Requests from your open Sieve tab appear in a toolbar popup with the exact text to be sent.",
  "homepage_url": "https://sieve.manideep.info",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sieve",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "sidePanel",
    "notifications",
    "storage"
  ],
  "commands": {
    "open-sieve": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Open or close Sieve"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://sieve.manideep.info/*",
      "https://sieve-manideep.web.app/*",
      "https://sieve-manideep.firebaseapp.com/*",
      "http://localhost:5173/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; connect-src 'none'; img-src 'self'; font-src 'self'; style-src 'self'"
  },
  "key": ""
}
