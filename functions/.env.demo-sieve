SIEVE_PUBLIC_BASE_URL=http://127.0.0.1:5000
RELAY_WAIT_SECONDS=6
SIEVE_PUSH_MODE=record
# Emulator on macOS only: the functions runtime forks its gunicorn worker after import, and a forked
# process aborts when it first reads the system proxy settings (Objective-C fork safety). These two
# values avoid that; they are never deployed (this file belongs to the demo-sieve project).
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
NO_PROXY=*
