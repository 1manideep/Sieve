# Copy this file to web/.env.local (git-ignored) and fill in the values.
# Only variables that start with VITE_ reach the app. None of these is a secret except where noted.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
# Web API key of the Firebase project.
VITE_FIREBASE_API_KEY=
# Auth domain, usually <project-id>.firebaseapp.com (or sieve.manideep.info, 40 V-19).
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase project id, for example sieve-manideep.
VITE_FIREBASE_PROJECT_ID=
# Web app id, 1:<number>:web:<hex>.
VITE_FIREBASE_APP_ID=
# Cloud Messaging sender id (the project number).
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Realtime Database URL, for example https://<project-id>-default-rtdb.firebaseio.com.
VITE_FIREBASE_DATABASE_URL=
# Web push certificate key pair (Cloud Messaging > Web configuration).
VITE_FCM_VAPID_KEY=
# Region of the callable functions; empty means us-central1.
VITE_FUNCTIONS_REGION=

# Sieve extension id (32 letters a-p); empty turns the extension bridge off.
VITE_EXTENSION_ID=
# Chrome Web Store page of the extension; when set it leads, and the zip the site serves becomes "Or load it unpacked".
VITE_EXTENSION_STORE_URL=
# Public source code URL, shown in the footer.
VITE_REPO_URL=

# Google Identity Services OAuth client id for Gmail read-only access (20 section 15.1).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Firebase AI Logic (10 section 4.2)
# reCAPTCHA Enterprise site key for App Check (public).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# App Check debug token: local development only, never in a production build. "true" or a registered UUID.
VITE_APPCHECK_DEBUG_TOKEN=
# Cloud model for drafting; empty uses the default in web/src/ai/config.ts.
VITE_CLOUD_MODEL_DRAFT=
# Cloud model for sample-data and consented fallback; empty uses the default in web/src/ai/config.ts.
VITE_CLOUD_MODEL_FALLBACK=

# Local development and tests
# "true" (or "1") connects Auth, Firestore, Realtime Database and Functions to the local emulators.
VITE_USE_EMULATORS=
# "true" (or "1") runs the end-to-end test seams (40 section 19, 60 section 3.9). Never in production.
VITE_E2E=
# "1" turns on the end-to-end model seam in the AI layer (60 section 3.9.1). Never in production.
VITE_SIEVE_E2E=
# "1" with VITE_USE_EMULATORS lets the home base answer relay requests from the Playground data (bench only, 60 section 4.7).
VITE_RELAY_FROM_PLAYGROUND=
